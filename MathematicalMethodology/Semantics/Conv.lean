import MathematicalMethodology.Semantics.Inst
import MathematicalMethodology.Operational.Compute

/-!
# Convertibility and soundness of computation

`Conv env` is the equivalence generated by the computation rules (delta, beta, case),
closed under the spine positions the checker works at (application parts and `case`
scrutinees).  It is the notion of equality the soundness theorem is about.

We prove that `Conv` is stable under substitution, and that the operational level
(`step`, `computeSafe`, `computeWide`) only ever produces `Conv`-equal terms.
-/

namespace MM

/-- Definitions in the environment are closed terms. -/
def EnvClosed (env : Env) : Prop := ∀ f t, env.lookup f = some t → t.closed

inductive Conv (env : Env) : Term → Term → Prop
  | refl (t : Term) : Conv env t t
  | symm {a b : Term} : Conv env a b → Conv env b a
  | trans {a b c : Term} : Conv env a b → Conv env b c → Conv env a c
  | delta (f : String) (t : Term) : env.lookup f = some t → Conv env (.const f) t
  | beta (b a : Term) : Conv env (.app (.abs b) a) (Term.beta b a)
  | caseRed (c : String) (args : List Term) (n : Nat) (alts : Alts) (body : Term) :
      alts.find? c = some (n, body) → args.length = n →
      Conv env (.cas (Term.mkApp (.con c) args) alts) (Term.instAlt n args body)
  | app {f f' a a' : Term} : Conv env f f' → Conv env a a' → Conv env (.app f a) (.app f' a')
  | cas {s s' : Term} (alts : Alts) : Conv env s s' → Conv env (.cas s alts) (.cas s' alts)

/-- `Conv` is stable under substitution (given closed definitions). -/
theorem Conv.subst {env : Env} (hE : EnvClosed env) {a b : Term} (h : Conv env a b)
    (σ : Nat → Term) : Conv env (a.subst σ) (b.subst σ) := by
  induction h with
  | refl t => exact .refl _
  | symm _ ih => exact .symm ih
  | trans _ _ ih1 ih2 => exact .trans ih1 ih2
  | delta f t hf =>
    show Conv env (Term.const f) (t.subst σ)
    rw [Term.closed_subst (hE f t hf) σ]
    exact .delta f t hf
  | beta b a =>
    show Conv env (Term.app (Term.abs (b.subst (upSub σ))) (a.subst σ))
      ((Term.beta b a).subst σ)
    rw [Term.beta_subst]
    exact .beta _ _
  | caseRed c args n alts body hf hl =>
    show Conv env (Term.cas ((Term.mkApp (.con c) args).subst σ) (alts.subst σ))
      ((Term.instAlt n args body).subst σ)
    rw [Term.mkApp_subst, Term.instAlt_subst n args body σ hl]
    exact .caseRed c _ n _ _ (Alts.find?_subst σ c alts n body hf) (by simpa using hl)
  | app _ _ ih1 ih2 => exact .app ih1 ih2
  | cas alts _ ih => exact .cas _ ih

/-! ## `step` is sound -/

theorem Term.step_app (env : Env) (f a : Term) :
    (Term.app f a).step env =
      match f with
      | .abs b => some (Term.beta b a)
      | _ => (f.step env).map fun f' => .app f' a := by
  cases f <;> rfl

theorem Term.step_sound (env : Env) :
    ∀ t t' : Term, t.step env = some t' → Conv env t t'
  | .var _, _, h => by simp [Term.step] at h
  | .con _, _, h => by simp [Term.step] at h
  | .abs _, _, h => by simp [Term.step] at h
  | .const f, t', h => by
    simp only [Term.step] at h
    exact .delta f t' h
  | .app f a, t', h => by
    have ih := Term.step_sound env f
    rw [Term.step_app] at h
    cases f with
    | abs b =>
      simp only [Option.some.injEq] at h
      subst h
      exact .beta b a
    | var i =>
      cases hs : (Term.var i).step env with
      | none => simp [hs] at h
      | some f' =>
        simp only [hs, Option.map_some, Option.some.injEq] at h
        subst h
        exact .app (ih f' hs) (.refl a)
    | con c =>
      cases hs : (Term.con c).step env with
      | none => simp [hs] at h
      | some f' =>
        simp only [hs, Option.map_some, Option.some.injEq] at h
        subst h
        exact .app (ih f' hs) (.refl a)
    | const g =>
      cases hs : (Term.const g).step env with
      | none => simp [hs] at h
      | some f' =>
        simp only [hs, Option.map_some, Option.some.injEq] at h
        subst h
        exact .app (ih f' hs) (.refl a)
    | app f1 f2 =>
      cases hs : (Term.app f1 f2).step env with
      | none => simp [hs] at h
      | some f' =>
        simp only [hs, Option.map_some, Option.some.injEq] at h
        subst h
        exact .app (ih f' hs) (.refl a)
    | cas s alts =>
      cases hs : (Term.cas s alts).step env with
      | none => simp [hs] at h
      | some f' =>
        simp only [hs, Option.map_some, Option.some.injEq] at h
        subst h
        exact .app (ih f' hs) (.refl a)
  | .cas s alts, t', h => by
    have ih := Term.step_sound env s
    simp only [Term.step] at h
    split at h
    · rename_i c args hsp
      split at h
      · rename_i n body hf
        split at h
        · rename_i hl
          simp only [Option.some.injEq] at h
          subst h
          have hs := Term.eq_mkApp_of_spine hsp
          rw [hs]
          exact .caseRed c args n alts body hf hl
        · simp at h
      · simp at h
    · cases hs : s.step env with
      | none => simp [hs] at h
      | some s' =>
        simp only [hs, Option.map_some, Option.some.injEq] at h
        subst h
        exact .cas alts (ih s' hs)

/-! ## `computeSafe`, `computeHere`, `computeWide` are sound -/

theorem Term.computeSafe_go_sound (env : Env) :
    ∀ (n : Nat) (t : Term) (best : Option Term) (u : Term),
      Term.computeSafe.go env n t best = some u → best = some u ∨ Conv env t u
  | 0, t, best, u, h => Or.inl h
  | n + 1, t, best, u, h => by
    simp only [Term.computeSafe.go] at h
    cases hs : t.step env with
    | none =>
      simp only [hs] at h
      exact Or.inl h
    | some t' =>
      simp only [hs] at h
      rcases Term.computeSafe_go_sound env n t' _ u h with h1 | h1
      · by_cases hc : t'.hasCas = true
        · simp only [hc, if_true] at h1
          exact Or.inl h1
        · simp only [hc] at h1
          have e := Option.some.inj h1
          subst e
          exact Or.inr (Term.step_sound env t _ hs)
      · exact Or.inr (.trans (Term.step_sound env t t' hs) h1)

theorem Term.computeSafe_sound (env : Env) (fuel : Nat) (t u : Term)
    (h : t.computeSafe env fuel = some u) : Conv env t u := by
  rcases Term.computeSafe_go_sound env fuel t none u h with h1 | h1
  · simp at h1
  · exact h1

theorem Term.computeHere_sound (env : Env) (fuel : Nat) (t u : Term)
    (h : Term.computeHere env fuel t = some u) : Conv env t u := by
  unfold Term.computeHere at h
  cases hc : t.computeSafe env fuel with
  | none => simp [hc] at h
  | some v =>
    simp only [hc] at h
    split at h
    · simp at h
    · simp only [Option.some.injEq] at h
      subst h
      exact Term.computeSafe_sound env fuel t v hc

theorem Term.computeWide_sound (env : Env) (fuel : Nat) :
    ∀ t u : Term, t.computeWide env fuel = some u → Conv env t u
  | .var i, u, h => Term.computeHere_sound env fuel _ u h
  | .con c, u, h => Term.computeHere_sound env fuel _ u h
  | .const f, u, h => Term.computeHere_sound env fuel _ u h
  | .abs b, u, h => Term.computeHere_sound env fuel _ u h
  | .app f a, u, h => by
    simp only [Term.computeWide] at h
    cases hh : Term.computeHere env fuel (.app f a) with
    | some v =>
      simp only [hh, Option.some.injEq] at h
      subst h
      exact Term.computeHere_sound env fuel _ v hh
    | none =>
      simp only [hh] at h
      cases hf : f.computeWide env fuel with
      | some f' =>
        simp only [hf, Option.some.injEq] at h
        subst h
        exact .app (Term.computeWide_sound env fuel f f' hf) (.refl a)
      | none =>
        simp only [hf] at h
        cases ha : a.computeWide env fuel with
        | none => simp [ha] at h
        | some a' =>
          simp only [ha, Option.map_some, Option.some.injEq] at h
          subst h
          exact .app (.refl f) (Term.computeWide_sound env fuel a a' ha)
  | .cas s alts, u, h => by
    simp only [Term.computeWide] at h
    cases hh : Term.computeHere env fuel (.cas s alts) with
    | some v =>
      simp only [hh, Option.some.injEq] at h
      subst h
      exact Term.computeHere_sound env fuel _ v hh
    | none =>
      simp only [hh] at h
      cases hs : s.computeWide env fuel with
      | none => simp [hs] at h
      | some s' =>
        simp only [hs, Option.map_some, Option.some.injEq] at h
        subst h
        exact .cas alts (Term.computeWide_sound env fuel s s' hs)

end MM
