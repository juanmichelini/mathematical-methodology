import MathematicalMethodology.Export.Proofs
import MathematicalMethodology.Examples.TestSuite
import MathematicalMethodology.Examples.Trees

/-!
# Export of the 35-lemma suite and the lemma chains of `Test.hs`

Everything the system proves in `Examples/TestSuite.lean`, printed as Lean: the data types and
functions of `Test.env`, then the theorems with the proofs the search found:

* `comp_l1 … comp_l5`: the five `lemascomp` lemmas, each from those before it;
* `lemma_l1 … lemma_l35`: `Test.lemas`, lemma `n` from `lemascomp` and the lemmas before it
  (as `provelemas` does), so each proof may use exactly those theorems;
* `chain_<f>_l1 …`: the lemmas `findlemas` finds for `suma`, `mult` (with those of `suma`),
  `flipexp`, `min`, `max`, `absr`, `and`, `or`, `not`, `concat`, `rev`.

A lemma the search could not prove is not printed as a theorem; it is listed in a comment and
counted.  Untrusted display code: Lean's kernel checks the result.
-/

namespace MM.Export

open MM MM.Strategic MM.Examples MM.Examples.TestEnv MM.Examples.TestSuite

/-- The only lemma of the suite the system does not prove: a `lemascomp` fact that needs `suma`
commutativity, which the suite proves later.  The Haskell takes it as given.  Anything else
unproved (or this one becoming provable) changes the report and must be looked at. -/
def suiteAssumed : List String := ["comp: x:Nat y:Nat |- mult (S x) y = suma y (mult x y)"]

/-- Signature of a function of the environment. -/
def sigOf (f : String) : Option Ty := (tenv.find? (·.1 == Term.const f)).map (·.2)

def suiteFuns : List (String × Ty × Term) :=
  env.filterMap fun (f, t) => (sigOf f).map fun ty => (f, ty, t)

/-- A whole development as one Lean file: data types, functions, and a theorem for every
proof in `groups` that is complete (group name, proofs, in order; each can use all earlier
theorems).  Returns the text, the number of theorems, the statements of the incomplete
proofs (`group: statement`) and the number of steps with no tactic. -/
def developmentFile (cmd ns : String) (ds : List DatasH) (funs : List (String × Ty × Term))
    (groups : List (String × List Proof)) : String × Nat × List String × Nat :=
  let failed := groups.flatMap fun (g, ps) =>
    (ps.filter fun p => !p.complete).filterMap fun p => p.head.map fun c => s!"{g}: {c.show}"
  let (ts, _, bad) := theoremsFor ds [] groups
  let hdr := s!"-- The data types and functions of a development and everything the system proves about\n" ++
    s!"-- them, with the proofs it found.  Generated by `lake exe export-lean {cmd}`; do not edit by hand.\n\n" ++
    s!"set_option linter.unusedVariables false\n\nnamespace {ns}\n\n"
  let note := String.join (failed.map fun f => s!"-- not proved by the system: {f}\n")
  (hdr ++ note ++ "\n".intercalate (ds.map (exportData ds)) ++ "\n" ++
    "\n".intercalate (funs.map fun (n, ty, t) => exportFun ds n ty t) ++ "\n" ++
    "\n".intercalate ts ++ s!"\nend {ns}\n", ts.length, failed, bad)

/-- The file text, the number of theorems, the lemmas the system failed to prove, and the
number of steps with no tactic, for `Test.hs`. -/
def suiteGroups : List (String × List Proof) :=
  [("comp", compProofs), ("lemma", lemmaProofs)] ++
    chainData.map fun (n, bs) => (s!"chain_{n}", bs.filterMap (·.chosen))

def suiteFile : String × Nat × List String × Nat :=
  developmentFile "suite" "SuiteEx" TestEnv.datas suiteFuns suiteGroups

/-- The same for the polymorphic-tree development of `Examples/Trees.lean` (#59). -/
def treesFuns : List (String × Ty × Term) :=
  MM.Examples.Trees.env'.filterMap fun (f, t) =>
    (MM.Examples.Trees.sigs.lookup f).map fun ty => (f, ty, t)

def treesGroups : List (String × List Proof) :=
  MM.Examples.Trees.chainData.map fun (n, bs) => (s!"chain_{n}", bs.filterMap (·.chosen))

def treesFile : String × Nat × List String × Nat :=
  developmentFile "trees" "TreesEx" MM.Examples.Trees.datas treesFuns treesGroups

end MM.Export
