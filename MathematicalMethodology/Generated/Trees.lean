-- them, with the proofs it found.  Generated by `lake exe export-lean trees`; do not edit by hand.

set_option linter.unusedVariables false

namespace TreesEx

inductive Nat where
  | O : Nat
  | S : Nat → Nat
  deriving DecidableEq, Repr

inductive List (ty_a : Type) where
  | Nil : List ty_a
  | Cons : ty_a → List ty_a → List ty_a
  deriving DecidableEq, Repr

inductive Tree (ty_a : Type) where
  | Hoja : ty_a → Tree ty_a
  | Nodo : Tree ty_a → Tree ty_a → Tree ty_a
  deriving DecidableEq, Repr

def suma (b : Nat) (a : Nat) : Nat :=
  match b with
  | Nat.O => a
  | Nat.S c => Nat.S (suma c a)

def concat {ty_a : Type} (b : List ty_a) (a : List ty_a) : List ty_a :=
  match b with
  | List.Nil => a
  | List.Cons c d => List.Cons c (concat d a)

def rev {ty_a : Type} (a : List ty_a) : List ty_a :=
  match a with
  | List.Nil => List.Nil
  | List.Cons b c => concat (rev c) (List.Cons b List.Nil)

def mirror {ty_a : Type} (a : Tree ty_a) : Tree ty_a :=
  match a with
  | Tree.Hoja b => Tree.Hoja b
  | Tree.Nodo b c => Tree.Nodo (mirror c) (mirror b)

def size {ty_a : Type} (a : Tree ty_a) : Nat :=
  match a with
  | Tree.Hoja b => Nat.S Nat.O
  | Tree.Nodo b c => suma (size b) (size c)

def flatten {ty_a : Type} (a : Tree ty_a) : List ty_a :=
  match a with
  | Tree.Hoja b => List.Cons b List.Nil
  | Tree.Nodo b c => concat (flatten b) (flatten c)

theorem chain_usuma_l1 (a : Nat) :
    suma Nat.O a = a := by
  change a = a
  try rfl

theorem chain_usuma_l2 (a : Nat) :
    suma a Nat.O = a := by
  induction a with
  | O =>
    change Nat.O = Nat.O
    try rfl
  | S d ih_d =>
    change Nat.S (suma d Nat.O) = Nat.S d
    try (conv => lhs; rw [ih_d])
    try rfl

theorem chain_usuma_l3 (a : Nat) (b : Nat) :
    suma (Nat.S a) b = Nat.S (suma b a) := by
  change Nat.S (suma a b) = Nat.S (suma b a)
  induction a generalizing b with
  | O =>
    change Nat.S b = Nat.S (suma b Nat.O)
    try (conv => rhs; rw [chain_usuma_l2 b])
    try rfl
  | S d ih_d =>
    change Nat.S (Nat.S (suma d b)) = Nat.S (suma b (Nat.S d))
    try (conv => lhs; rw [ih_d b])
    induction b with
    | O =>
      change Nat.S (Nat.S d) = Nat.S (Nat.S d)
      try rfl
    | S e ih_e =>
      change Nat.S (Nat.S (Nat.S (suma e d))) = Nat.S (Nat.S (suma e (Nat.S d)))
      try (conv => rhs; rw [← ih_e])
      try rfl

theorem chain_usuma_l4 (b : Nat) (a : Nat) :
    suma a (Nat.S b) = Nat.S (suma a b) := by
  induction b generalizing a with
  | O =>
    try (conv => rhs; rw [chain_usuma_l2 a])
    induction a with
    | O =>
      change Nat.S Nat.O = Nat.S Nat.O
      try rfl
    | S d ih_d =>
      change Nat.S (suma d (Nat.S Nat.O)) = Nat.S (Nat.S d)
      try (conv => lhs; rw [ih_d])
      try rfl
  | S d ih_d =>
    try (conv => rhs; rw [ih_d a])
    induction a with
    | O =>
      change Nat.S (Nat.S d) = Nat.S (Nat.S d)
      try rfl
    | S e ih_e =>
      change Nat.S (suma e (Nat.S (Nat.S d))) = Nat.S (Nat.S (Nat.S (suma e d)))
      try (conv => lhs; rw [ih_e])
      try rfl

theorem chain_usuma_l5 (c : Nat) (d : Nat) :
    suma c d = suma d c := by
  induction c generalizing d with
  | O =>
    change d = suma d Nat.O
    try (conv => rhs; rw [chain_usuma_l2 d])
    try rfl
  | S e ih_e =>
    change Nat.S (suma e d) = suma d (Nat.S e)
    try (conv => rhs; rw [chain_usuma_l4 e d])
    try (conv => lhs; rw [ih_e d])
    try rfl

theorem chain_usuma_l6 (a : Nat) (b : Nat) (f : Nat) :
    suma (suma a b) f = suma (suma a f) b := by
  induction a generalizing b f with
  | O =>
    change suma b f = suma f b
    try (conv => rhs; rw [← chain_usuma_l5 b f])
    try rfl
  | S d ih_d =>
    change suma (Nat.S (suma d b)) f = suma (Nat.S (suma d f)) b
    change Nat.S (suma (suma d b) f) = Nat.S (suma (suma d f) b)
    try (conv => lhs; rw [← chain_usuma_l5 b d])
    try (conv => rhs; rw [← chain_usuma_l5 b (suma d f)])
    induction b generalizing f with
    | O =>
      change Nat.S (suma d f) = Nat.S (suma d f)
      try rfl
    | S e ih_e =>
      change Nat.S (suma (Nat.S (suma e d)) f) = Nat.S (Nat.S (suma e (suma d f)))
      change Nat.S (Nat.S (suma (suma e d) f)) = Nat.S (Nat.S (suma e (suma d f)))
      try (conv => lhs; rw [← chain_usuma_l5 d e])
      try (conv => rhs; rw [← chain_usuma_l5 (suma d f) e])
      try (conv => rhs; rw [← ih_d e f])
      try rfl

theorem chain_usuma_l7 (b : Nat) (e : Nat) (f : Nat) :
    suma b (suma e f) = suma (suma b e) f := by
  induction b generalizing e f with
  | O =>
    change suma e f = suma e f
    try rfl
  | S d ih_d =>
    change Nat.S (suma d (suma e f)) = suma (Nat.S (suma d e)) f
    change Nat.S (suma d (suma e f)) = Nat.S (suma (suma d e) f)
    try (conv => rhs; rw [← ih_d e f])
