  change (List.Nil : List ty_a) = (List.Nil : List ty_a)
  try rfl

theorem chain_urev_l2 {ty_a : Type} (a : List ty_a) (b : List ty_a) :
    rev (concat a b) = concat (rev b) (rev a) := by
  induction a generalizing b with
  | Nil =>
    change rev b = concat (rev b) (List.Nil : List ty_a)
    try (conv => rhs; rw [chain_uconcat_l2 (rev b)])
    try rfl
  | Cons c d ih_d =>
    change rev (List.Cons c (concat d b)) = concat (rev b) (concat (rev d) (List.Cons c (List.Nil : List ty_a)))
    change concat (rev (concat d b)) (List.Cons c (List.Nil : List ty_a)) = concat (rev b) (concat (rev d) (List.Cons c (List.Nil : List ty_a)))
    try (conv => lhs; rw [ih_d b])
    try (conv => lhs; rw [← chain_uconcat_l4 (rev b) (rev d) (List.Cons c (List.Nil : List ty_a))])
    try rfl

theorem chain_urev_l3 {ty_a : Type} (a : List ty_a) :
    rev (rev a) = a := by
  induction a with
  | Nil =>
    change rev (List.Nil : List ty_a) = (List.Nil : List ty_a)
    change (List.Nil : List ty_a) = (List.Nil : List ty_a)
    try rfl
  | Cons b c ih_c =>
    change rev (concat (rev c) (List.Cons b (List.Nil : List ty_a))) = List.Cons b c
    try (conv => lhs; rw [chain_urev_l2 (rev c) (List.Cons b (List.Nil : List ty_a))])
    change concat (concat (rev (List.Nil : List ty_a)) (List.Cons b (List.Nil : List ty_a))) (rev (rev c)) = List.Cons b c
    change concat (concat (List.Nil : List ty_a) (List.Cons b (List.Nil : List ty_a))) (rev (rev c)) = List.Cons b c
    change concat (List.Cons b (List.Nil : List ty_a)) (rev (rev c)) = List.Cons b c
    change List.Cons b (concat (List.Nil : List ty_a) (rev (rev c))) = List.Cons b c
    change List.Cons b (rev (rev c)) = List.Cons b c
    try (conv => lhs; rw [ih_c])
    try rfl

