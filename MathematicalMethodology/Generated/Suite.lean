theorem chain_uconcat_l2 {ty_a : Type} (a : List ty_a) :
    concat a (List.Nil : List ty_a) = a := by
  induction a with
  | Nil =>
    change (List.Nil : List ty_a) = (List.Nil : List ty_a)
    try rfl
  | Cons b c ih_c =>
    change List.Cons b (concat c (List.Nil : List ty_a)) = List.Cons b c
    try (conv => lhs; rw [ih_c])
    try rfl

theorem chain_uconcat_l3 {ty_a : Type} (a : ty_a) (b : List ty_a) (f : List ty_a) :
