    change Nat.S (suma a d) = suma d (Nat.S a)
    try (conv => rhs; rw [chain_usuma_l4 a d])
    try (conv => rhs; rw [← ih_a d])
    try rfl

theorem chain_usuma_l6 (a : Nat) (b : Nat) (f : Nat) :
    suma (suma a b) f = suma (suma a f) b := by
  induction a generalizing b f with
  | O =>
    change suma b f = suma f b
    try (conv => rhs; rw [← chain_usuma_l5 b f])
    try rfl
  | S c ih_c =>
    change suma (Nat.S (suma c b)) f = suma (Nat.S (suma c f)) b
    change Nat.S (suma (suma c b) f) = Nat.S (suma (suma c f) b)
    try (conv => lhs; rw [← chain_usuma_l5 b c])
    try (conv => rhs; rw [← ih_c b f])
    try (conv => rhs; rw [← chain_usuma_l5 b c])
    try rfl

theorem chain_usuma_l7 (b : Nat) (e : Nat) (f : Nat) :
    suma b (suma e f) = suma (suma b e) f := by
  induction b generalizing e f with
  | O =>
    change suma e f = suma e f
    try rfl
  | S a ih_a =>
    change Nat.S (suma a (suma e f)) = suma (Nat.S (suma a e)) f
    change Nat.S (suma a (suma e f)) = Nat.S (suma (suma a e) f)
    try (conv => rhs; rw [← ih_a e f])
    try rfl

theorem chain_umult_l1 (a : Nat) :
    mult Nat.O a = Nat.O := by
  change Nat.O = Nat.O
  try rfl

theorem chain_umult_l2 (a : Nat) :
    mult a Nat.O = Nat.O := by
  induction a with
  | O =>
    change Nat.O = Nat.O
    try rfl
  | S b ih_b =>
    change suma (mult b Nat.O) Nat.O = Nat.O
    try (conv => lhs; rw [chain_usuma_l2 (mult b Nat.O)])
    try (conv => lhs; rw [ih_b])
    try rfl

theorem chain_umult_l3 (a : Nat) (b : Nat) :
    mult (Nat.S a) b = suma (mult a b) b := by
  change suma (mult a b) b = suma (mult a b) b
  try rfl

theorem chain_umult_l4 (b : Nat) (a : Nat) :
    mult a (Nat.S b) = suma a (mult a b) := by
  induction b generalizing a with
  | O =>
    try (conv => rhs; rw [chain_umult_l2 a])
    try (conv => rhs; rw [chain_usuma_l2 a])
    induction a with
    | O =>
      change Nat.O = Nat.O
      try rfl
    | S b ih_b =>
      change suma (mult b (Nat.S Nat.O)) (Nat.S Nat.O) = Nat.S b
      try (conv => lhs; rw [chain_usuma_l4 Nat.O (mult b (Nat.S Nat.O))])
      try (conv => lhs; rw [chain_usuma_l2 (mult b (Nat.S Nat.O))])
      try (conv => lhs; rw [ih_b])
      try rfl
  | S c ih_c =>
    try (conv => rhs; rw [ih_c a])
    induction a with
    | O =>
      change Nat.O = suma Nat.O (mult Nat.O c)
      change Nat.O = mult Nat.O c
      change Nat.O = Nat.O
      try rfl
    | S b ih_b =>
      change suma (mult b (Nat.S (Nat.S c))) (Nat.S (Nat.S c)) = Nat.S (suma b (suma (Nat.S b) (mult (Nat.S b) c)))
      change suma (mult b (Nat.S (Nat.S c))) (Nat.S (Nat.S c)) = Nat.S (suma b (Nat.S (suma b (mult (Nat.S b) c))))
      change suma (mult b (Nat.S (Nat.S c))) (Nat.S (Nat.S c)) = Nat.S (suma b (Nat.S (suma b (suma (mult b c) c))))
      try (conv => lhs; rw [ih_b])
      try (conv => rhs; rw [chain_usuma_l4 (suma b (suma (mult b c) c)) b])
      try (conv => lhs; rw [chain_usuma_l4 (Nat.S c) (suma b (suma b (mult b c)))])
      try (conv => lhs; rw [chain_usuma_l4 c (suma b (suma b (mult b c)))])
      try (conv => lhs; rw [← chain_usuma_l7 b (suma b (mult b c)) c])
      try (conv => lhs; rw [← chain_usuma_l7 b (mult b c) c])
      try rfl

theorem chain_umult_l5 (a : Nat) (b : Nat) (f : Nat) :
    mult (suma a b) f = suma (mult b f) (mult f a) := by
  induction a generalizing b f with
  | O =>
    change mult b f = suma (mult b f) (mult f Nat.O)
    try (conv => rhs; rw [chain_umult_l2 f])
    try (conv => rhs; rw [chain_usuma_l2 (mult b f)])
    try rfl
  | S c ih_c =>
    change mult (Nat.S (suma c b)) f = suma (mult b f) (mult f (Nat.S c))
    change suma (mult (suma c b) f) f = suma (mult b f) (mult f (Nat.S c))
    try (conv => lhs; rw [ih_c b f])
    try (conv => rhs; rw [chain_umult_l4 c f])
    try (conv => lhs; rw [← chain_usuma_l7 (mult b f) (mult f c) f])
    try (conv => rhs; rw [← chain_usuma_l5 (mult f c) f])
    try rfl

theorem chain_umult_l6 (b : Nat) (f : Nat) (a : Nat) :
    mult a (suma b f) = suma (mult a b) (mult a f) := by
  induction b generalizing f a with
  | O =>
    change mult a f = suma (mult a Nat.O) (mult a f)
    try (conv => rhs; rw [chain_umult_l2 a])
    change mult a f = mult a f
    try rfl
  | S c ih_c =>
    change mult a (Nat.S (suma c f)) = suma (mult a (Nat.S c)) (mult a f)
    try (conv => lhs; rw [chain_umult_l4 (suma c f) a])
    try (conv => rhs; rw [chain_umult_l4 c a])
    try (conv => lhs; rw [ih_c f a])
    try (conv => rhs; rw [← chain_usuma_l7 a (mult a c) (mult a f)])
    try rfl

theorem chain_umult_l7 (c : Nat) (d : Nat) :
    mult c d = mult d c := by
  induction c generalizing d with
  | O =>
    change Nat.O = mult d Nat.O
    try (conv => rhs; rw [chain_umult_l2 d])
    try rfl
  | S a ih_a =>
    change suma (mult a d) d = mult d (Nat.S a)
    try (conv => rhs; rw [chain_umult_l4 a d])
    try (conv => rhs; rw [← ih_a d])
    try (conv => rhs; rw [← chain_usuma_l5 (mult a d) d])
    try rfl

theorem chain_umult_l8 (b : Nat) (e : Nat) (f : Nat) :
    mult b (mult e f) = mult (mult b e) f := by
  induction b generalizing e f with
  | O =>
    change Nat.O = mult Nat.O f
    change Nat.O = Nat.O
    try rfl
  | S a ih_a =>
    change suma (mult a (mult e f)) (mult e f) = mult (suma (mult a e) e) f
    try (conv => rhs; rw [chain_umult_l5 (mult a e) e f])
    try (conv => rhs; rw [← chain_umult_l7 (mult a e) f])
    try (conv => rhs; rw [← ih_a e f])
    try (conv => rhs; rw [← chain_usuma_l5 (mult a (mult e f)) (mult e f)])
    try rfl

theorem chain_uflipexp_l1 (a : Nat) :
