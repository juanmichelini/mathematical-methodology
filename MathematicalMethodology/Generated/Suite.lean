  try rfl

theorem chain_uflipexp_l3 (a : Nat) (b : Nat) (f : Nat) :
    flipexp (suma a b) f = mult (flipexp a f) (flipexp b f) := by
  induction a generalizing b f with
  | O =>
    change flipexp b f = mult (Nat.S Nat.O) (flipexp b f)
    change flipexp b f = suma (mult Nat.O (flipexp b f)) (flipexp b f)
    change flipexp b f = suma Nat.O (flipexp b f)
    change flipexp b f = flipexp b f
    try rfl
  | S c ih_c =>
    change flipexp (Nat.S (suma c b)) f = mult (mult (flipexp c f) f) (flipexp b f)
    change mult (flipexp (suma c b) f) f = mult (mult (flipexp c f) f) (flipexp b f)
    try (conv => lhs; rw [ih_c b f])
    try (conv => lhs; rw [← chain_umult_l8 (flipexp c f) (flipexp b f) f])
    try (conv => rhs; rw [← chain_umult_l8 (flipexp c f) f (flipexp b f)])
    try (conv => lhs; rw [← chain_umult_l7 (mult (flipexp b f) f) (flipexp c f)])
    try (conv => rhs; rw [← chain_umult_l7 (flipexp b f) f])
    try (conv => lhs; rw [← chain_umult_l8 (flipexp b f) f (flipexp c f)])
    try (conv => rhs; rw [← chain_umult_l7 (mult (flipexp b f) f) (flipexp c f)])
    try (conv => lhs; rw [← chain_umult_l7 (flipexp c f) f])
    try (conv => rhs; rw [← chain_umult_l8 (flipexp b f) f (flipexp c f)])
    try (conv => rhs; rw [← chain_umult_l7 (flipexp c f) f])
    try rfl

theorem chain_uflipexp_l4 (a : Nat) (b : Nat) (f : Nat) :
    flipexp (mult a b) f = flipexp a (flipexp b f) := by
  induction a generalizing b f with
  | O =>
    change flipexp Nat.O f = Nat.S Nat.O
    change Nat.S Nat.O = Nat.S Nat.O
    try rfl
  | S c ih_c =>
    change flipexp (suma (mult c b) b) f = mult (flipexp c (flipexp b f)) (flipexp b f)
    try (conv => lhs; rw [chain_uflipexp_l3 (mult c b) b f])
    try (conv => lhs; rw [ih_c b f])
    try rfl

