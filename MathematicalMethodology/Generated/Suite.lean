theorem chain_uconcat_l4 {ty_a : Type} (b : List ty_a) (e : List ty_a) (f : List ty_a) :
    concat b (concat e f) = concat (concat b e) f := by
  induction b generalizing e f with
  | Nil =>
    change concat e f = concat e f
    try rfl
  | Cons a c ih_c =>
    change List.Cons a (concat c (concat e f)) = concat (List.Cons a (concat c e)) f
    change List.Cons a (concat c (concat e f)) = List.Cons a (concat (concat c e) f)
    try (conv => rhs; rw [← ih_c e f])
    try rfl

theorem chain_urev_l1 {ty_a : Type} :
